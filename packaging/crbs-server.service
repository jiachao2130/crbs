[Unit]
Description=CRBS HTTP API Server
Documentation=https://github.com/cuap/crbs
# hub 对外提供服务 + SSE 长连接：online 语义与 worker 对齐，文件描述符上限同步。
Wants=network-online.target
After=network-online.target

[Service]
LimitNOFILE=65536
Type=simple
ExecStart=/usr/bin/crbs-server run --run-dir /run/crbs
Restart=on-failure
RestartSec=5
# systemd 等待进程退出的超时；超过后发 SIGKILL。
# server.toml 中 shutdown_timeout_secs（默认 60s）约束停机的两段等待：
# HTTP 连接排空 + 等活跃构建完成；TimeoutStopSec=310 仅作为外层兜底，
# 保证极端情况下（配置调大或排空卡死）服务仍能被 systemd 收走。
TimeoutStopSec=310

# Run as an unprivileged dedicated user. Privileged operations (mount, chroot,
# container spawn) are delegated to the setuid-root crbs-priv-helper.
User=crbs-server
Group=crbs
SupplementaryGroups=crbs
# 绑定低端口（原生 TLS 直连 443）所需。勿收窄 CapabilityBoundingSet——
# bounding 跨 setuid exec 封顶会废掉 crbs-priv-helper 的 mount/chroot 能力；
# ambient 遇 setuid exec 被内核清除不外泄，NoNewPrivileges 保持默认关闭。
AmbientCapabilities=CAP_NET_BIND_SERVICE

# systemd 创建 /run/crbs 并属主设为 crbs-server，供 pid/port 文件使用。
RuntimeDirectory=crbs

# Hardening. NoNewPrivileges is intentionally disabled so the server can invoke
# the setuid-root helper. All other restrictions are kept as tight as possible.
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# NOTE: If you configure a custom result_dir outside of /var/lib/crbs (e.g.
# /data/crbs-results), you MUST add it to ReadWritePaths, otherwise the server
# process will see that path as read-only and builds will fail with EROFS.
# The server's real write set under /etc/crbs is only two targets: POST
# /products/{name}/init generates {config_dir}/crbs.toml (when missing) and
# products/{name}.toml; product CRUD itself lives in SQLite under
# /var/lib/crbs. /etc/crbs must stay writable as a directory because RPM does
# not ship /etc/crbs/crbs.toml (it may not exist at unit start, and creating
# it needs a writable parent), so narrowing ReadWritePaths to
# /etc/crbs/crbs.toml + /etc/crbs/products is only possible once the RPM
# guarantees that file exists.
ReadWritePaths=/var/lib/crbs /run/crbs /etc/crbs
ProtectKernelTunables=true
ProtectKernelModules=true
# Note: ProtectControlGroups is intentionally NOT enabled. It would mount the
# cgroup hierarchy read-only in the service mount namespace, and the setuid
# helper inherits that namespace, so nspawn cannot create the payload
# subcgroup and hub-local builds fail at install-deps with EROFS.
# Note: RestrictNamespaces is intentionally left at default (no restriction),
# because the helper must spawn chroot/nspawn containers.

[Install]
WantedBy=multi-user.target
