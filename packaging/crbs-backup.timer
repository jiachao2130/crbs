[Unit]
Description=Nightly timer for CRBS backup
Documentation=https://github.com/cuap/crbs
# 用途：每天拉起一次 crbs-backup.service（SQLite 快照 + 滚动保留，默认保留 7 份）。
# 启用方式（安装 unit 后）：
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now crbs-backup.timer
# 查看运行情况：systemctl list-timers crbs-backup.timer
# 手动跑一次：  sudo systemctl start crbs-backup.service

[Timer]
# 每天一次。需要固定时刻可改为如 OnCalendar=*-*-* 03:30:00（详见 systemd.time(7)）。
OnCalendar=daily
# 机器关机错过的调度在下次启动后补跑一次（备份场景希望补跑）。
Persistent=true

[Install]
WantedBy=timers.target
